<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="repeat_timer_maui.MainPage"
             Title="Repeat Timer">
    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16">
            <Label
                Text="Repeat Timer"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Duration"
                FontSize="16" />

            <Entry
                x:Name="DurationEntry"
                Keyboard="Text"
                Placeholder="90 or 1:30"
                Text="4"
                TextChanged="OnDurationEntryTextChanged" />

            <Label
                x:Name="DurationHintLabel"
                Text="Enter seconds or mm:ss"
                FontSize="14" />

            <Label
                x:Name="StatusLabel"
                Text="Ready"
                FontSize="18"
                FontAttributes="Bold" />

            <Button
                x:Name="StartButton"
                Text="Start"
                Clicked="OnStartButtonClicked" />

            <Button
                x:Name="NextButton"
                Text="Next"
                Clicked="OnNextButtonClicked" />

            <Button
                x:Name="IncreaseButton"
                Text="Increase 10%"
                Clicked="OnIncreaseButtonClicked" />

            <Button
                x:Name="DecreaseButton"
                Text="Decrease 10%"
                Clicked="OnDecreaseButtonClicked" />

            <Button
                x:Name="DoneButton"
                Text="Done"
                Clicked="OnDoneButtonClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
